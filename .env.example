# Everything here is optional. Copy this file to .env to change a setting.

# Where the app listens. 127.0.0.1 = only this computer. Use 0.0.0.0 to reach it from
# other devices or when hosting it, but then APP_PASSWORD below is required.
HOST=127.0.0.1
PORT=8000

# One shared password for the whole app (the browser asks for it; any user name works)
APP_PASSWORD=

# Where recordings are saved
RECORD_DIR=recordings

# What to do if a live only offers a landscape stream:
#   skip = refuse to record (strictly vertical only)
#   crop = center-crop the landscape stream to 9:16 (re-encodes, uses more CPU)
LANDSCAPE_FALLBACK=skip

# Max simultaneous recordings, and an optional length cap in seconds (0 = until the live ends)
MAX_CONCURRENT=3
MAX_RECORD_SECONDS=0

# A TikTok sessionid cookie, only for lives that need a logged-in viewer
TIKTOK_SESSIONID=

# 1 = save each live's room info to ./debug (URL tokens removed) to inspect its layouts
DEBUG_DUMP=0
